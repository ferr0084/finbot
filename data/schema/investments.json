{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Investment Holdings",
  "description": "Investment holdings with cost basis. Current prices are NOT stored here — they are fetched live from market data providers at query time.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "description": "Unique holding identifier" },
      "account_id": { "type": "string", "description": "Reference to account ID in accounts.json" },
      "ticker": { "type": "string", "description": "Ticker symbol (e.g. VTI, AAPL, BND)" },
      "shares": { "type": "number", "description": "Number of shares held", "exclusiveMinimum": 0 },
      "cost_basis_per_share": { "type": "number", "description": "Average cost basis per share (only changes on buy/sell)", "exclusiveMinimum": 0 },
      "description": { "type": "string", "description": "Optional human-readable name for custom/non-traded funds" },
      "asset_class": {
        "type": "string",
        "enum": ["us_stock", "intl_stock", "emerging_stock", "bond", "real_estate", "commodity", "crypto", "cash", "alternative", "target_date", "other"],
        "description": "Asset class for allocation analysis"
      },
      "sector": { "type": "string", "description": "Sector (for stocks)", "examples": ["technology", "healthcare", "finance", "energy"] },
      "purchase_date": { "type": "string", "format": "date", "description": "Date of purchase (ISO 8601)" },
      "notes": { "type": "string", "description": "Optional notes" }
    },
    "required": ["id", "account_id", "ticker", "shares", "cost_basis_per_share", "asset_class"]
  }
}
