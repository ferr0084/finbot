{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary"
    },
    "plan": {
      "mode": "primary"
    }
  },
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "yahoo-finance": {
        "type": "local",
        "command": ["bun", "run", "scripts/yahoo-finance-mcp/index.ts"],
        "disabled": false,
        "timeout": {
          "catalog": 15000,
          "execution": 120000
        }
      }
    }
  }
}
