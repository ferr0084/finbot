{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary"
    },
    "plan": {
      "mode": "primary"
    }
  },
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "tool", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "bun run scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "python3 scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/*", "effect": "allow" }
  ],
  "websearch": {
    "provider": "tinyfish"
  },
  "mcp": {
    "servers": {
      "yahoo-finance": {
        "type": "local",
        "command": ["bun", "run", "scripts/yahoo-finance-mcp/index.ts"],
        "disabled": false,
        "timeout": {
          "catalog": 15000,
          "execution": 120000
        }
      },
      "fin-data": {
        "type": "local",
        "command": ["bun", "run", "scripts/yahoo-finance-mcp/fin-data.ts"],
        "disabled": false,
        "timeout": {
          "catalog": 15000,
          "execution": 120000
        }
      }
    }
  }
}
